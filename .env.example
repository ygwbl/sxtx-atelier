# ==============================================================================
# 📜 Paper Atelier (纸境工坊) · Environment Variables Template
# 复制本文件为 .env 即可生效：cp .env.example .env
# ==============================================================================

# 运行端口（默认 8080）
PORT=8080

# 生产环境标识
NODE_ENV=production

# [可选] 管理员首次初始化口令（长度需 >= 12 位；若留空，启动时会在控制台随机打印一次）
ATELIER_INITIAL_PASSWORD=

# [可选] 签名凭据 Salt（留空将使用内建随机派生）
ATELIER_AUTH_SALT=

# [可选] 大模型智能回笔与自治写作引擎配置（支持任意 OpenAI 兼容接口）
# 支持：DeepSeek、智谱 GLM、通义千问、Kimi、Moonshot、Ollama、Claude/OpenAI 等
AI_API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
AI_MODEL=glm-4-flash

# [可选] 图像生成服务（用于文章全自动配图，支持 pipiwang / standard dall-e）
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=

# [可选] 搜索引擎实时推送 IndexNow Key (https://www.indexnow.org/)
INDEXNOW_KEY=
